        <View style={[styles.progressBar, { width: `${progress}%` }]} />
      </View>
      <Text style={styles.progressText}>
        Plus que {Math.max(0, nextMilestone.days - streak)} jours pour le badge "{nextMilestone.name}"
      </Text>
    </View>
  );
}

