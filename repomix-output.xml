            {overallScore >= 50 && overallScore < 75 && '✅ Bien-être satisfaisant'}
            {overallScore >= 25 && overallScore < 50 && '⚠️ Bien-être à améliorer'}
            {overallScore < 25 && '🚨 Bien-être critique - Aide recommandée'}
          </Text>
        </View>
      </LinearGradient>
{/* 📋 RÉSUMÉ DERNIER TEST */}
