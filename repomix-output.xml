  },
  scoreTitle: {
    fontSize: 26,
    fontWeight: '700',
    marginBottom: theme.spacing(1),
  },
  scoreSubtitle: {
    fontSize: 16,
    color: theme.colors.sub,
    marginBottom: theme.spacing(3),
  },
  scoreDetails: {
    width: '100%',
    alignItems: 'center',
  },
  scoreLabel: {
