      <View style={styles.recFooter}>
        <Text style={styles.recDuration}>
          <Ionicons name="time-outline" size={12} /> {typeof recommendation.duration === 'string' ? recommendation.duration : '5 min'}
        </Text>
        <View style={styles.recActionBadge}>
